<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Locales\en.json" />
    <Content Remove="Locales\zh.json" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Locales\en.json" />
    <EmbeddedResource Include="Locales\zh.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BootstrapBlazor" Version="11.1.0" />
    <PackageReference Include="BootstrapBlazor.Chart" Version="11.0.0" />
    <PackageReference Include="BootstrapBlazor.FontAwesome" Version="11.0.0" />
    <PackageReference Include="BootstrapBlazor.Html2Pdf" Version="11.0.0" />
    <PackageReference Include="BootstrapBlazor.Middleware" Version="11.0.0" />
    <PackageReference Include="BootstrapBlazor.TableExport" Version="11.0.0" />
    <PackageReference Include="BootstrapBlazor.Tasks.Dashboard" Version="11.0.0" />
  </ItemGroup>

</Project>
